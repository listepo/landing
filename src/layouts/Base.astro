---
import "@fontsource-variable/inter";
// Preload the Latin subset so text does not reflow when Inter replaces the fallback (CLS).
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/tailwind.css";
import Icon from "../components/Icon.astro";
import { u, BRAND, THEMES, type ThemeKey } from "../lib/site";
import { getTools, proFor } from "../lib/catalog";
import { productsWithDocs } from "../lib/docs";
import { graph } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  theme: ThemeKey;
  accent?: string;
  accent2?: string;
  accentLight?: string;
  /** Open Graph type: "website" (default) or "article" for docs pages. */
  ogType?: "website" | "article";
  /** Alt text for the share card, when the card's text is known. */
  imageAlt?: string;
  /** schema.org nodes for this page, emitted as one JSON-LD graph. */
  jsonLd?: object[];
}
const { title, description, theme, ogType = "website", imageAlt, jsonLd = [], ...over } = Astro.props;
const t = { ...THEMES[theme], ...Object.fromEntries(Object.entries(over).filter(([, v]) => v)) };
const vars = `--accent:${t.accent};--accent-2:${t.accent2};--accent-light:${t.accentLight};--bg:${t.bg}`;
const og = new URL(u(`/images/${t.images}/og.jpg`), Astro.site).href;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href;
const tools = await getTools();
const current = tools.find((x) => x.id === theme);
const withDocs = new Set(productsWithDocs());
const docTools = tools.filter((x) => withDocs.has(x.id));
const inDocs = /\/docs(\/|$)/.test(Astro.url.pathname);
---
<!doctype html>
<html lang="en" style={vars} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={t.bg} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <!-- Pyrlyn favicon (public/pyrlyn/); the previous public/favicon.svg stays in the repo, unlinked. -->
    <link rel="icon" href={u("/pyrlyn/pyrlyn-favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={u("/pyrlyn/pyrlyn-favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={u("/pyrlyn/pyrlyn-favicon-64.png")} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={u("/pyrlyn/pyrlyn-apple-touch-icon.png")} />
    <link rel="sitemap" type="application/xml" href={u("/sitemap-index.xml")} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(graph(jsonLd)).replace(/</g, "\\u003c")} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="mesh" aria-hidden="true">
      <span class="mesh__blob mesh__blob--1"></span>
      <span class="mesh__blob mesh__blob--2"></span>
      <span class="mesh__blob mesh__blob--3"></span>
      <span class="mesh__blob mesh__blob--4"></span>
      <span class="mesh__blob mesh__blob--5"></span>
      <span class="mesh__grid"></span>
      <span class="mesh__grain"></span>
    </div>

    <header class="nav tw:max-[459px]:px-2!">
      <div class="nav__inner tw:max-[459px]:gap-2! tw:max-[459px]:pl-3! tw:max-[359px]:gap-1!">
        <a class="brand tw:max-[459px]:pr-0!" href={u("/")} aria-label={`${BRAND} home`}>
          <span class="brand__mark" aria-hidden="true"></span>
          <span>listepo <span class="brand__sub tw:max-[459px]:hidden!">tools</span></span>
        </a>
        <a class="pyrlyn-by pyrlyn-by--nav" href="https://github.com/pyrlyn" aria-label="Pyrlyn">
          <span class="pyrlyn-by__by tw:max-[459px]:hidden!" aria-hidden="true">by</span>
          <img class="tw:max-[459px]:hidden!" src={u("/pyrlyn/pyrlyn-lockup-on-dark.svg")} alt="" width="69" height="20" />
          <img class="tw:min-[460px]:hidden!" src={u("/pyrlyn/pyrlyn-mark-on-dark.svg")} alt="" width="28" height="28" />
        </a>
        <nav aria-label="Primary">
          <ul class="nav__links">
            <li class="menu">
              <details class="menu__details" data-menu>
                <summary class="menu__trigger tw:max-[459px]:px-2! tw:max-[359px]:px-1!" aria-current={current ? "page" : undefined}>
                  Products{current && <span class="menu__current">· {current.data.title}</span>}
                  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="menu__panel glass glass--thick">
                  <p class="menu__label">All products · {tools.length}</p>
                  <ul class="menu__grid">
                    {tools.map((x) => (
                      <li>
                        <a class="menu__item shine" href={u(`/${x.id}/`)} style={`--card-accent:${x.data.accent}`} aria-current={x.id === theme ? "page" : undefined}>
                          <span class="menu__mark" aria-hidden="true">{x.data.title.slice(0, 2)}</span>
                          <span class="menu__text"><strong>{x.data.title} <span class="menu__ver">v{x.data.version}</span></strong><small>{x.data.tagline}</small></span>
                          <span class="menu__price">Free · Pro {proFor(x).price}*</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {docTools.length > 0 && (
                    <>
                      <p class="menu__label">Documentation</p>
                      <ul class="menu__docs" role="list">
                        {docTools.map((x) => (
                          <li><a class="menu__doc" href={u(`/${x.id}/docs/`)} style={`--card-accent:${x.data.accent}`} aria-current={inDocs && x.id === theme ? "page" : undefined}><i aria-hidden="true"></i>{x.data.title} docs</a></li>
                        ))}
                      </ul>
                    </>
                  )}
                  <p class="menu__foot"><a href={u("/#catalog")}>Browse the catalog →</a><span>* Pro prices are placeholders</span></p>
                </div>
              </details>
            </li>
            <li><a href={u("/#how")}>How it works</a></li>
            <li><a href={u("/#pricing")}>Pricing</a></li>
            <li><a href={u("/#faq")}>FAQ</a></li>
          </ul>
        </nav>
        <div class="nav__actions">
          <a class="btn btn--glass nav__gh" href="https://github.com/listepo"><Icon name="github" size={16} /> GitHub</a>
          <a class="btn btn--primary tw:max-[459px]:px-4! tw:max-[359px]:px-3!" href={u("/#catalog")}>Browse tools</a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="tw:overflow-x-clip">
      <slot />
    </main>

    <footer class="footer container">
      <div class="footer__row">
        <div class="footer__brands">
          <a class="brand" href={u("/")}><span class="brand__mark" aria-hidden="true"></span><span>listepo <span class="brand__sub">tools</span></span></a>
          <a class="pyrlyn-by pyrlyn-by--footer" href="https://github.com/pyrlyn" aria-label="Pyrlyn">
            <span class="pyrlyn-by__by" aria-hidden="true">by</span>
            <img src={u("/pyrlyn/pyrlyn-lockup-on-dark.svg")} alt="" width="89" height="26" loading="lazy" />
          </a>
        </div>
        <nav aria-label="Footer">
          <ul class="footer__links">
            {tools.map((x) => <li><a href={u(`/${x.id}/`)}>{x.data.title}</a></li>)}
            {docTools.map((x) => <li><a href={u(`/${x.id}/docs/`)}>{x.data.title} docs</a></li>)}
            <li><a href={u("/#pricing")}>Pricing</a></li>
            <li><a href={u("/#faq")}>FAQ</a></li>
            <li><a href="https://github.com/listepo">GitHub</a></li>
          </ul>
        </nav>
      </div>
      <p>A storefront for AI developer tools. Every tool has a free open-source edition; Pro tiers, their prices and Pro features shown on this site are placeholders. Product facts come from each tool’s own README, docs and site copy.</p>
    </footer>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
